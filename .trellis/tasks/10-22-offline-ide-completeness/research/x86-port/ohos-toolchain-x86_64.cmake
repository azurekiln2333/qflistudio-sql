set(QFLI_OHOS_SDK "/root/qfli-mysql-ohos-x64-1022/ohos-sdk" CACHE PATH "Isolated OHOS SDK")
set(QFLI_CLANG "/usr/bin/clang-18" CACHE FILEPATH "Linux Clang for OHOS")
set(QFLI_CLANGXX "/usr/bin/clang++-18" CACHE FILEPATH "Linux Clang++ for OHOS")
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_C_COMPILER "${QFLI_CLANG}")
set(CMAKE_CXX_COMPILER "${QFLI_CLANGXX}")
set(CMAKE_C_COMPILER_TARGET x86_64-linux-ohos)
set(CMAKE_CXX_COMPILER_TARGET x86_64-linux-ohos)
set(CMAKE_SYSROOT "${QFLI_OHOS_SDK}/sysroot")
set(CMAKE_C_FLAGS_INIT "-resource-dir=${QFLI_OHOS_SDK}/llvm/lib/clang/15.0.4")
set(CMAKE_CXX_FLAGS_INIT "-resource-dir=${QFLI_OHOS_SDK}/llvm/lib/clang/15.0.4 -stdlib=libc++ -nostdinc++ -isystem ${QFLI_OHOS_SDK}/llvm/include/libcxx-ohos/include/c++/v1")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld -L${QFLI_OHOS_SDK}/llvm/lib/x86_64-linux-ohos")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld -L${QFLI_OHOS_SDK}/llvm/lib/x86_64-linux-ohos")
set(CMAKE_FIND_ROOT_PATH "${QFLI_OHOS_SDK}/sysroot")
set(CMAKE_LIBRARY_PATH
  "${QFLI_OHOS_SDK}/sysroot/usr/lib/x86_64-linux-ohos"
  "${QFLI_OHOS_SDK}/llvm/lib/x86_64-linux-ohos")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
