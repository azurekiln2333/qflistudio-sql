set(QFLI_ANDROID_NDK "" CACHE PATH "Android NDK 27 root")
set(QFLI_ANDROID_ABI "x86_64" CACHE STRING "Android 64-bit ABI")
set(QFLI_ANDROID_API "28" CACHE STRING "Minimum Oracle Android API")
set(QFLI_CLANG "/usr/bin/clang-18" CACHE FILEPATH "Host LLVM 18 compiler")
set(QFLI_CLANGXX "/usr/bin/clang++-18" CACHE FILEPATH "Host LLVM 18 C++ compiler")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES
  QFLI_ANDROID_NDK QFLI_ANDROID_ABI QFLI_ANDROID_API QFLI_CLANG QFLI_CLANGXX)
set(QFLI_NDK_PREBUILT "${QFLI_ANDROID_NDK}/toolchains/llvm/prebuilt/linux-x86_64")
if(NOT EXISTS "${QFLI_NDK_PREBUILT}/sysroot")
  set(QFLI_NDK_PREBUILT "${QFLI_ANDROID_NDK}/toolchains/llvm/prebuilt/windows-x86_64")
endif()
if(QFLI_ANDROID_ABI STREQUAL "x86_64")
  set(QFLI_ANDROID_TRIPLE x86_64-linux-android)
  set(CMAKE_SYSTEM_PROCESSOR x86_64)
elseif(QFLI_ANDROID_ABI STREQUAL "arm64-v8a")
  set(QFLI_ANDROID_TRIPLE aarch64-linux-android)
  set(CMAKE_SYSTEM_PROCESSOR aarch64)
else()
  message(FATAL_ERROR "Oracle MySQL requires a 64-bit Android target")
endif()
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_C_COMPILER "${QFLI_CLANG}")
set(CMAKE_CXX_COMPILER "${QFLI_CLANGXX}")
set(CMAKE_C_COMPILER_TARGET "${QFLI_ANDROID_TRIPLE}${QFLI_ANDROID_API}")
set(CMAKE_CXX_COMPILER_TARGET "${QFLI_ANDROID_TRIPLE}${QFLI_ANDROID_API}")
set(CMAKE_SYSROOT "${QFLI_NDK_PREBUILT}/sysroot")
set(QFLI_ANDROID_LIBDIR "${CMAKE_SYSROOT}/usr/lib/${QFLI_ANDROID_TRIPLE}")
set(CMAKE_C_FLAGS_INIT "-resource-dir=${QFLI_NDK_PREBUILT}/lib/clang/18 -rtlib=compiler-rt -femulated-tls -fPIC")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT} -stdlib=libc++ -nostdinc++ -isystem ${CMAKE_SYSROOT}/usr/include/c++/v1")
set(CMAKE_CXX_STANDARD_LIBRARIES
  "${QFLI_NDK_PREBUILT}/lib/clang/18/lib/linux/${CMAKE_SYSTEM_PROCESSOR}/libunwind.a -Wl,--exclude-libs,libunwind.a")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld -Wl,-z,max-page-size=16384 -Wl,-z,common-page-size=16384")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${CMAKE_EXE_LINKER_FLAGS_INIT}")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_LIBRARY_PATH "${QFLI_ANDROID_LIBDIR}/${QFLI_ANDROID_API}" "${QFLI_ANDROID_LIBDIR}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_AR /usr/bin/llvm-ar-18)
set(CMAKE_RANLIB /usr/bin/llvm-ranlib-18)
