cmake_minimum_required(VERSION 3.21)

if(NOT QFLI_MYSQL_PORT_ROOT)
  get_filename_component(QFLI_MYSQL_REPO_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
  set(QFLI_MYSQL_PORT_ROOT "${QFLI_MYSQL_REPO_ROOT}/build/mysql-port")
endif()
set(QFLI_MYSQL_SOURCE "${QFLI_MYSQL_PORT_ROOT}/mysql-8.4.6")
set(QFLI_MYSQL_BUILD "${QFLI_MYSQL_PORT_ROOT}/ohos-build")
set(QFLI_MYSQL_PACKAGE "${QFLI_MYSQL_PORT_ROOT}/package")
set(QFLI_MYSQL_PACKAGE_LIBS "${QFLI_MYSQL_PACKAGE}/libs/arm64-v8a")
set(QFLI_MYSQL_PACKAGE_DATA "${QFLI_MYSQL_PACKAGE}/rawfile/mysql")

foreach(library qfli_mysql qfli_mysql_server)
  set(source "${QFLI_MYSQL_BUILD}/qfli-runtime/lib/lib${library}.so")
  if(NOT EXISTS "${source}")
    message(FATAL_ERROR "Missing Oracle MySQL runtime artifact: ${source}")
  endif()
endforeach()
if(NOT EXISTS "${QFLI_MYSQL_BUILD}/share/english/errmsg.sys")
  message(FATAL_ERROR "Missing generated Oracle MySQL error messages")
endif()

file(MAKE_DIRECTORY "${QFLI_MYSQL_PACKAGE_LIBS}" "${QFLI_MYSQL_PACKAGE_DATA}/share/english"
  "${QFLI_MYSQL_PACKAGE_DATA}/licenses")
find_program(QFLI_MYSQL_READOBJ NAMES llvm-readobj-18 llvm-readobj REQUIRED)
find_program(QFLI_MYSQL_STRIP NAMES llvm-strip-18 llvm-strip REQUIRED)
set(QFLI_MYSQL_LIBRARY_QUEUE
  "${QFLI_MYSQL_BUILD}/qfli-runtime/lib/libqfli_mysql.so"
  "${QFLI_MYSQL_BUILD}/qfli-runtime/lib/libqfli_mysql_server.so")
set(QFLI_MYSQL_PACKAGED_LIBRARIES "")
set(QFLI_MYSQL_PLATFORM_LIBRARIES libc.so libc++_shared.so libace_napi.z.so
  libhilog_ndk.z.so libm.so libdl.so libpthread.so)
while(QFLI_MYSQL_LIBRARY_QUEUE)
  list(POP_FRONT QFLI_MYSQL_LIBRARY_QUEUE library)
  get_filename_component(name "${library}" NAME)
  if(name IN_LIST QFLI_MYSQL_PACKAGED_LIBRARIES)
    continue()
  endif()
  execute_process(COMMAND "${QFLI_MYSQL_READOBJ}" --needed-libs --elf-output-style=JSON "${library}"
    RESULT_VARIABLE status OUTPUT_VARIABLE metadata ERROR_VARIABLE diagnostic)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot read Oracle MySQL shared dependencies: ${diagnostic}")
  endif()
  string(JSON architecture GET "${metadata}" 0 FileSummary Arch)
  if(NOT architecture STREQUAL "aarch64")
    message(FATAL_ERROR "Oracle MySQL package contains a non-ARM64 library: ${library}")
  endif()
  file(COPY "${library}" DESTINATION "${QFLI_MYSQL_PACKAGE_LIBS}" FOLLOW_SYMLINK_CHAIN)
  execute_process(COMMAND "${QFLI_MYSQL_STRIP}" --strip-unneeded "${QFLI_MYSQL_PACKAGE_LIBS}/${name}"
    RESULT_VARIABLE status ERROR_VARIABLE diagnostic)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot strip packaged Oracle MySQL library: ${diagnostic}")
  endif()
  list(APPEND QFLI_MYSQL_PACKAGED_LIBRARIES "${name}")
  string(JSON count LENGTH "${metadata}" 0 NeededLibraries)
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
      string(JSON dependency GET "${metadata}" 0 NeededLibraries ${index})
      if(dependency IN_LIST QFLI_MYSQL_PLATFORM_LIBRARIES)
        continue()
      endif()
      set(dependency_source "")
      foreach(directory
          "${QFLI_MYSQL_BUILD}/qfli-runtime/lib" "${QFLI_MYSQL_BUILD}/library_output_directory")
        if(EXISTS "${directory}/${dependency}")
          set(dependency_source "${directory}/${dependency}")
          break()
        endif()
      endforeach()
      if(NOT dependency_source)
        message(FATAL_ERROR "Missing Oracle MySQL shared dependency ${dependency}, required by ${name}")
      endif()
      list(APPEND QFLI_MYSQL_LIBRARY_QUEUE "${dependency_source}")
    endforeach()
  endif()
endwhile()
file(COPY "${QFLI_MYSQL_BUILD}/share/english/errmsg.sys"
  DESTINATION "${QFLI_MYSQL_PACKAGE_DATA}/share/english")
file(COPY "${QFLI_MYSQL_SOURCE}/share/charsets"
  DESTINATION "${QFLI_MYSQL_PACKAGE_DATA}/share")
file(COPY "${QFLI_MYSQL_SOURCE}/extra/icu/icudt77l"
  DESTINATION "${QFLI_MYSQL_PACKAGE_DATA}/share/icu")
configure_file("${QFLI_MYSQL_SOURCE}/LICENSE"
  "${QFLI_MYSQL_PACKAGE_DATA}/licenses/Oracle-MySQL-8.4.6-LICENSE.txt" COPYONLY)
configure_file("${QFLI_MYSQL_PORT_ROOT}/openssl-3.5.3/LICENSE.txt"
  "${QFLI_MYSQL_PACKAGE_DATA}/licenses/OpenSSL-3.5.3-LICENSE.txt" COPYONLY)

file(GLOB_RECURSE QFLI_MYSQL_RUNTIME_FILES LIST_DIRECTORIES FALSE
  RELATIVE "${QFLI_MYSQL_PACKAGE_DATA}" "${QFLI_MYSQL_PACKAGE_DATA}/share/*")
list(SORT QFLI_MYSQL_RUNTIME_FILES)
string(JSON QFLI_MYSQL_MANIFEST SET "{}" version "\"8.4.6\"")
string(JSON QFLI_MYSQL_MANIFEST SET "${QFLI_MYSQL_MANIFEST}" files "[]")
set(index 0)
foreach(path IN LISTS QFLI_MYSQL_RUNTIME_FILES)
  string(JSON QFLI_MYSQL_MANIFEST SET "${QFLI_MYSQL_MANIFEST}" files ${index} "\"${path}\"")
  math(EXPR index "${index} + 1")
endforeach()
file(WRITE "${QFLI_MYSQL_PACKAGE_DATA}/runtime.json" "${QFLI_MYSQL_MANIFEST}\n")
message(STATUS "Oracle MySQL runtime staged at ${QFLI_MYSQL_PACKAGE}")
